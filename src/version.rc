    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Warband party screen (Prisma UI bridge)"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "WarbandUI"
            VALUE "LegalCopyright", "Seth Summers"
            VALUE "ProductName", "WarbandUI"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
